{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetaHarn",
  "version": "0.1.0",
  "identifier": "com.metaharn.web",
  "build": {
    "beforeDevCommand": "npm run dev:full",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MetaHarn",
        "width": 960,
        "height": 720,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
