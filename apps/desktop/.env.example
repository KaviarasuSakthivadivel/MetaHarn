DATABASE_URL=postgres://metaharn:metaharn@localhost:5432/metaharn

# Which Pi-registered model to use for sessions. Falls back to Pi's default
# (first available authenticated model) if this pair isn't found/authenticated.
METAHARN_MODEL_PROVIDER=anthropic
METAHARN_MODEL_ID=claude-opus-4-5

# Pi resolves credentials itself (stored auth.json, ANTHROPIC_API_KEY env var,
# etc.) — see docs/PLAN.md and Pi's own auth docs. Nothing MetaHarn-specific
# needed here for local dev if you've already run `pi login` or have
# ANTHROPIC_API_KEY set in your shell.

# Chat-session backend, alongside Pi — see docs/research/openworker-integration.md
# ("Owning the Loop") and apps/desktop/src/main/ownedEngine.ts. Default (unset,
# or any value other than "owned") is Pi, unchanged. "owned" selects MetaHarn's
# own engine (@metaharn/engine): no durable transcript yet, in-memory per
# window only — a real resume story is deliberate later work.
# METAHARN_CHAT_ENGINE=owned

# Only read when METAHARN_CHAT_ENGINE=owned and METAHARN_MODEL_PROVIDER=anthropic
# (the default) — the owned engine resolves its own credentials directly from
# these standard SDK env vars, unlike Pi.
# ANTHROPIC_API_KEY=sk-ant-...
# Only read when METAHARN_CHAT_ENGINE=owned and METAHARN_MODEL_PROVIDER=openai.
# OPENAI_API_KEY=sk-...

# Crash reporting (@sentry/electron — see src/main/crashReporting.ts) is off by default and
# stays off for everyone unless BOTH of two things are true: this is set to a real DSN from your
# own Sentry project (sentry.io, or a self-hosted instance), AND the person running the app has
# separately opted in from Settings -> About -> Privacy. There is no bundled/shared DSN in this
# repo — set your own if you maintain a public build and want crash reports.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
