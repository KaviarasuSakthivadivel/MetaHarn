{
  "name": "metaharn",
  "private": true,
  "version": "0.1.0",
  "description": "Meta-harness for an agentic dev platform: institutional-memory context grounding on top of an embedded agent harness.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run start --workspace=apps/desktop",
    "dev:server": "npm run dev --workspace=apps/server",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "rebuild:for-electron": "electron-rebuild -f -w better-sqlite3 --version $(node -p \"require('./node_modules/electron/package.json').version\")",
    "rebuild:for-node": "npm rebuild better-sqlite3"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vite": "^8.2.1"
  },
  "overrides": {
    "@electron/rebuild": "^4.2.0"
  }
}
